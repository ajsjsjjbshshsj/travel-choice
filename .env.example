# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=travel_decision_platform

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- Airflow ----
AIRFLOW_PORT=8088
TRAVEL_API_BASE_URL=http://host.docker.internal:8080/api

# ---- Kafka / Realtime ----
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
RECOMMEND_REQUEST_TOPIC=recommend_request_event

# ---- ClickHouse ----
CLICKHOUSE_DATABASE=travel_realtime
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_URL=jdbc:clickhouse://127.0.0.1:8123/travel_realtime
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ---- Flink ----
FLINK_WEB_PORT=8081
HOT_DESTINATION_TOP_N=10
HOT_DESTINATION_WINDOW_MINUTES=5

# ---- 高德地图 ----
# 申请地址: https://console.amap.com/dev/key/app
# 选择 "Web服务" 类型 Key，用于路线规划和天气查询
AMAP_API_KEY=your_amap_key_here

# ---- Spring Boot ----
SPRING_DATASOURCE_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}

# ---- JWT ----
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000
